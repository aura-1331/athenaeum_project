{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Athenaeum",
  "version": "1.1.3",
  "identifier": "com.aura.library",
  
  "build": {
  "beforeDevCommand": "npm run dev",
  "devUrl": "http://localhost:1420",
  "beforeBuildCommand": "npm run build",
  "frontendDist": "../dist"
 },
  "app": {
    "windows": [
  {
    "label": "main",
    "title": "The Athenaeum",
    "url": "index.html"
  }
 ],
  "security": {
  "csp": "default-src 'self'; img-src 'self' https://* data:; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 https://athenaeum-api.onrender.com",
  "capabilities": ["default"]
 }
  },
  "plugins": {
  "updater": {
    "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCRjdBQkFCQkI0Q0ZGQjAKUldTdy8weTdxNnYzU3dWSmRaVS9xNno4YjFPUm10MTdQK29zZXBFcTM1TnBHRTEvcnpXc1JSNFcK",
    "endpoints": [
      "https://github.com/aura-1331/athenaeum_project/releases/latest/download/latest.json"
    ],
    "dialog": true
  }
  },
  
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }

}
